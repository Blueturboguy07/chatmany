{
  "name": "chatmany",
  "version": "0.1.0",
  "description": "Self-hosted Instagram comment-to-DM automation using the official Meta Instagram API. Free, open-source, single-creator.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply chatmany --local",
    "db:migrate:remote": "wrangler d1 migrations apply chatmany --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^22.10.0",
    "puppeteer": "^25.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.119.0"
  }
}
