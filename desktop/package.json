  "description": "chatmany on your computer: comment-to-DM automations for Instagram. The automations run in the cloud on publik.",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "publik",
    "url": "https://publikhq.com"
  },
  "homepage": "https://publikhq.com/chatmany",
