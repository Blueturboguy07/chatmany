{
  "name": "chatmany-desktop",
  "productName": "chatmany",
  "version": "0.1.0",
  "description": "chatmany on your computer: comment-to-DM automations for Instagram. The automations run in the cloud on publik.",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "publik",
    "url": "https://publikhq.com"
  },
  "homepage": "https://publikhq.com/chatmany",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
